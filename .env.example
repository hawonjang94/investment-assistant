# Serper News API Key (https://serper.dev/ 에서 발급)
SERPER_API_KEY=your_serper_api_key_here

# Google AI Studio Gemini API Key (https://aistudio.google.com/ 에서 발급)
GEMINI_API_KEY=your_gemini_api_key_here

# Dify 챗봇 API 설정 (https://cloud.dify.ai/ 액세스 지점 > 백엔드 서비스 API)
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_ANALYSIS_API_KEY=your_dify_analysis_chatbot_key_here
DIFY_TECH_API_KEY=your_dify_tech_chatbot_key_here

# Flask 설정
FLASK_DEBUG=true
